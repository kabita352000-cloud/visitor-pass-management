{
  "info": {
    "_postman_id": "a13e4c33-bf39-4fa6-a3d8-6035174b6f94",
    "name": "Visitor Pass Management API",
    "description": "Requests for all Visitor Pass Management backend endpoints. Start with Health, log in, then set the token collection variable from the login response. Copy returned record IDs into the matching collection variables before running dependent requests.",
